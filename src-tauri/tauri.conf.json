{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ownize AI Studio",
  "version": "1.2.0",
  "identifier": "com.ownize.facefinder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ownize AI Studio",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQzlCMUEzQ0FGMUU2NDMKUldSRDV2SEtvN0hKV3doWG5FN05EUkdpS25wR1NiY0NBUHRoSWhiOThLTTNlS0YrdGFoTmVIQ0cK",
      "endpoints": [
        "https://github.com/linggaprrrr/tauri-facefinder/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
